---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import { SITE, LINKS } from '../config';
import { byOrder } from '../lib/utils';
import { localePath, t, useUI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = useUI(lang);

const education = (await getCollection('education')).sort(byOrder);
const research = (await getCollection('research')).sort(byOrder);
const experience = (await getCollection('experience')).sort(byOrder);
const internships = experience.filter((e) => e.data.category === 'internship');
const employment = experience.filter((e) => e.data.category === 'employment');
const training = experience.filter((e) => e.data.category === 'training');
const fellowships = (await getCollection('fellowships')).sort(byOrder);
const skills = (await getCollection('skills')).sort(byOrder);
const activities = (await getCollection('activities')).sort(byOrder);
const links = LINKS.filter((l) => l.href);
const name = t(SITE.name, lang);
const description = lang === 'ja' ? `${name}の経歴。` : `Curriculum vitae of ${name}.`;
---

<Base lang={lang} title={u('cv.title')} description={description}>
  <Window title={u('cv.title')}>
    <div class="cv-head">
      <div>
        <h1>{name} <span class="alt">{t(SITE.altName, lang)}</span></h1>
        <p class="muted mono">{t(SITE.role, lang)} · {t(SITE.affiliation, lang)}</p>
      </div>
      <div class="btn-row">
        {SITE.cvPdf && <a class="btn primary" href={SITE.cvPdf}>{u('cv.pdf')}</a>}
        <a class="btn" href={localePath('/publications/', lang)}>{u('nav.publications')}</a>
        {
          links.map((l) => (
            <a class="btn" href={l.href} rel="noopener">
              {l.label} ↗
            </a>
          ))
        }
      </div>
    </div>
  </Window>

  <Window title={u('cv.education')}>
    <dl class="rows">
      {
        education.map((e) => (
          <>
            <dt class="mono">{t(e.data.period, lang)}</dt>
            <dd>
              <strong>{t(e.data.degree, lang)}</strong>
              <div>{t(e.data.school, lang)}</div>
              <dl class="meta">
                {e.data.lab && (
                  <>
                    <dt>{u('cv.lab')}</dt>
                    <dd>
                      {e.data.labUrl ? (
                        <a href={e.data.labUrl} rel="noopener">
                          {t(e.data.lab, lang)}
                        </a>
                      ) : (
                        t(e.data.lab, lang)
                      )}
                    </dd>
                  </>
                )}
                {e.data.advisor && (
                  <>
                    <dt>{u('cv.advisor')}</dt>
                    <dd>{t(e.data.advisor, lang)}</dd>
                  </>
                )}
                {e.data.thesis && (
                  <>
                    <dt>{u(`cv.thesis.${e.data.level}`)}</dt>
                    <dd>{t(e.data.thesis, lang)}</dd>
                  </>
                )}
                {e.data.research && (
                  <>
                    <dt>{u('cv.research')}</dt>
                    <dd>{t(e.data.research, lang)}</dd>
                  </>
                )}
              </dl>
            </dd>
          </>
        ))
      }
    </dl>
  </Window>

  <Window title={u('cv.interests')}>
    <ul class="interests">
      {
        research.map((r) => (
          <li>
            <span class="mono period">{r.data.period}</span>
            <strong>{t(r.data.title, lang)}</strong>
          </li>
        ))
      }
    </ul>
  </Window>

  <div class="cols">
    <Window title={u('cv.internships')} status={u('pub.items')(internships.length)}>
      <ul class="entries">
        {
          internships.map((e) => (
            <li>
              <span class="mono period">{e.data.period}</span>
              <strong>{t(e.data.org, lang)}</strong>
              <span>{t(e.data.title, lang)}</span>
              {e.data.place && <span class="muted">{t(e.data.place, lang)}</span>}
            </li>
          ))
        }
      </ul>
    </Window>

    <Window title={u('cv.employment')}>
      <ul class="entries">
        {
          employment.map((e) => (
            <li>
              <span class="mono period">
                {e.data.period}
                {e.data.kind && <span class="tag dim">{u(`cv.kind.${e.data.kind}`)}</span>}
              </span>
              <strong>{t(e.data.org, lang)}</strong>
              <span>{t(e.data.title, lang)}</span>
            </li>
          ))
        }
      </ul>
    </Window>
  </div>

  <Window title={u('cv.skills')}>
    <dl class="rows skills">
      {
        skills.map((s) => (
          <>
            <dt>{t(s.data.group, lang)}</dt>
            <dd class="tags">
              {s.data.items.map((i) => (
                <span class="tag">{t(i, lang)}</span>
              ))}
            </dd>
          </>
        ))
      }
    </dl>
  </Window>

  <div class="cols3">
    <Window title={u('cv.training')}>
      <ul class="entries">
        {
          training.map((e) => (
            <li>
              <span class="mono period">{e.data.period}</span>
              <strong>{t(e.data.org, lang)}</strong>
              <span>{t(e.data.title, lang)}</span>
            </li>
          ))
        }
      </ul>
    </Window>

    <Window title={u('cv.scholarships')}>
      <ul class="entries">
        {
          fellowships.map((f) => (
            <li>
              <span class="mono period">{f.data.period}</span>
              {f.data.org && <strong>{t(f.data.org, lang)}</strong>}
              <span>{t(f.data.title, lang)}</span>
            </li>
          ))
        }
      </ul>
    </Window>

    <Window title={u('cv.activities')}>
      <ul class="plain">
        {activities.map((a) => <li>{t(a.data.name, lang)}</li>)}
      </ul>
    </Window>
  </div>
</Base>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .cv-head .btn-row {
    max-width: 460px;
    justify-content: flex-end;
  }
  h1 {
    margin: 0 0 4px;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  h1 .alt {
    margin-left: 8px;
    font-size: 0.5em;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
  .cv-head p {
    margin: 0;
    font-size: 0.8rem;
  }

  /* 学歴・スキル: 左に期間 / 見出し、右に内容 */
  .rows {
    display: grid;
    grid-template-columns: 11.5em 1fr;
    gap: 16px 20px;
    margin: 0;
  }
  .rows > dt {
    padding-top: 2px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .rows > dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    margin: 6px 0 0;
    font-size: 0.86rem;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    padding-top: 2px;
    white-space: nowrap;
  }
  .meta dd {
    margin: 0;
  }
  .skills > dt {
    color: var(--ink);
    font-weight: 650;
    font-size: 0.85rem;
  }
  .skills dd {
    gap: 6px;
  }
  .skills .tag {
    white-space: normal;
  }

  /* 研究分野 */
  .interests {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .interests li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 0.95rem;
  }

  /* 狭いボックス用: 期間を上に、内容を下に */
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entries li {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .entries li:first-child {
    padding-top: 0;
  }
  .entries li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .period {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .interests .period {
    flex: none;
    width: 3.6em;
    margin: 0;
  }
  .plain {
    margin: 0;
    padding-left: 1.2em;
    font-size: 0.92rem;
    line-height: 1.9;
  }

  .cols3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .cols3 {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 640px) {
    .rows {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .rows > dd {
      margin-bottom: 14px;
    }
    .interests {
      grid-template-columns: 1fr;
    }
    .cv-head .btn-row {
      justify-content: flex-start;
    }
  }
</style>
