---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import PubItem from '../components/PubItem.astro';
import PostList from '../components/PostList.astro';
import { SITE, LINKS } from '../config';
import { byYmDesc, getPosts } from '../lib/utils';
import { localePath, t, useUI, ymLabel, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = useUI(lang);

const bio = await getEntry('profile', lang);
const Bio = bio ? (await render(bio)).Content : null;
const news = (await getCollection('news')).sort(byYmDesc).slice(0, 6);
const selected = (await getCollection('publications', ({ data }) => data.selected)).sort(byYmDesc);
const posts = (await getPosts()).slice(0, 5);
const links = LINKS.filter((l) => l.href);
const initials = 'HT';
---

<Base lang={lang}>
  <Window title={u('home.about')} status={t(SITE.affiliation, lang)} statusRight={u('home.location')}>
    <div class="hero">
      <div class="photo" class:list={{ placeholder: !SITE.photo }}>
        {
          SITE.photo ? (
            <img src={SITE.photo} alt={t(SITE.name, lang)} width="512" height="512" />
          ) : (
            <span>{initials}</span>
          )
        }
      </div>
      <div class="intro">
        <p class="kicker mono">{t(SITE.role, lang)} · {t(SITE.lab, lang)}</p>
        <h1>
          {t(SITE.name, lang)}
          <span class="alt" lang={lang === 'en' ? 'ja' : 'en'}>{t(SITE.altName, lang)}</span>
        </h1>
        <div class="bio">{Bio && <Bio />}</div>
        <div class="btn-row">
          <a class="btn primary" href={localePath('/publications/', lang)}>{u('nav.publications')}</a>
          <a class="btn" href={localePath('/cv/', lang)}>{u('nav.cv')}</a>
          <a class="btn" href={localePath('/blog/', lang)}>{u('nav.blog')}</a>
          {
            links.map((l) => (
              <a class="btn" href={l.href} rel="noopener">
                {l.label} ↗
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Window>

  <div class="cols">
    <Window title={u('home.news')}>
      <ul class="news">
        {
          news.map((n) => (
            <li>
              <span class="mono date">{ymLabel(n.data.date, lang)}</span>
              <span>
                {n.data.link ? (
                  <a href={n.data.link.startsWith('/') ? localePath(n.data.link, lang) : n.data.link}>
                    {t(n.data.text, lang)}
                  </a>
                ) : (
                  t(n.data.text, lang)
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </Window>

    <Window title={u('home.latest')}>
      <PostList posts={posts} lang={lang} showTags={false} empty={u('home.noPosts')} />
      <div class="more"><a class="btn" href={localePath('/blog/', lang)}>{u('home.allPosts')}</a></div>
    </Window>
  </div>

  <Window title={u('home.selected')}>
    <ol class="pubs">
      {selected.map((p, i) => <PubItem pub={p} lang={lang} label={String(i + 1)} />)}
    </ol>
    <div class="more"><a class="btn" href={localePath('/publications/', lang)}>{u('home.fullList')}</a></div>
  </Window>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    align-items: start;
  }
  .photo {
    aspect-ratio: 1;
    border: var(--bw) solid var(--ink);
    box-shadow: 4px 4px 0 var(--shadow);
    overflow: hidden;
    background: var(--window);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo.placeholder {
    display: grid;
    place-items: center;
    background:
      repeating-conic-gradient(color-mix(in srgb, var(--teal) 30%, transparent) 0 25%, transparent 0 50%) 0 0 / 8px 8px,
      var(--window);
  }
  .photo.placeholder span {
    padding: 2px 10px;
    border: var(--bw) solid var(--ink);
    background: var(--window);
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
  }
  .kicker {
    margin: 0 0 4px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 4.4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  :global(:lang(ja)) h1 {
    letter-spacing: 0.02em;
  }
  h1 .alt {
    display: inline-block;
    margin-left: 12px;
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
    vertical-align: middle;
  }
  .bio :global(p) {
    margin: 0 0 12px;
  }
  .bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .intro .btn-row {
    margin-top: 18px;
  }

  .news {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .news li {
    display: grid;
    grid-template-columns: 5.6em 1fr;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    font-size: 0.93rem;
    line-height: 1.6;
  }
  .news li:last-child {
    border-bottom: 0;
  }
  .date {
    padding-top: 1px;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more {
    display: flex;
    justify-content: flex-end;
    margin-top: 14px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .photo {
      width: 128px;
    }
  }
</style>
