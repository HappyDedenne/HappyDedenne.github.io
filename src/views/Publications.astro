---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import PubItem from '../components/PubItem.astro';
import AwardList from '../components/AwardList.astro';
import { byYmDesc } from '../lib/utils';
import { SITE } from '../config';
import { t, useUI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = useUI(lang);
const all = (await getCollection('publications')).sort(byYmDesc);
const awards = (await getCollection('awards')).sort(byYmDesc);

const groups = [
  { type: 'journal', key: 'pub.journal', prefix: 'J' },
  { type: 'international', key: 'pub.international', prefix: 'C' },
  { type: 'domestic', key: 'pub.domestic', prefix: 'D' },
] as const;
const sections = groups
  .map((g) => ({ ...g, items: all.filter((p) => p.data.type === g.type) }))
  .filter((g) => g.items.length > 0);

const name = t(SITE.name, lang);
const description = lang === 'ja' ? `${name}の研究業績（発表論文・受賞歴）。` : `Publications and awards of ${name}.`;
---

<Base lang={lang} title={u('pub.title')} description={description}>
  <h1 class="visually-hidden">{u('pub.title')}</h1>

  {
    sections.map((s) => (
      <Window title={u(s.key)} status={u('pub.items')(s.items.length)}>
        <ol class="pubs">
          {s.items.map((p, i) => (
            <PubItem pub={p} lang={lang} label={`${s.prefix}${s.items.length - i}`} />
          ))}
        </ol>
      </Window>
    ))
  }

  <Window title={u('pub.awards')} status={u('pub.items')(awards.length)}>
    <AwardList awards={awards} lang={lang} />
  </Window>
</Base>

<style>
  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
