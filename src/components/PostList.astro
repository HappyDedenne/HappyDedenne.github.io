---
import type { Post } from '../lib/utils';
import { isoDate, slugifyTag } from '../lib/utils';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  posts: Post[];
  lang: Lang;
  showTags?: boolean;
  empty: string;
}
const { posts, lang, showTags = true, empty } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty mono">{empty}</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <time class="mono" datetime={isoDate(p.data.pubDate)}>
            {isoDate(p.data.pubDate)}
          </time>
          <div>
            <a class="post-title" href={`/blog/${p.id}/`} lang={p.data.lang}>
              {p.data.title}
            </a>
            <span class="tag dim">{p.data.lang.toUpperCase()}</span>
            {p.data.draft && <span class="tag hl">DRAFT</span>}
            {showTags && p.data.tags.length > 0 && (
              <div class="tags">
                {p.data.tags.map((t) => (
                  <a class="tag" href={localePath(`/blog/tags/${slugifyTag(t)}/`, lang)}>
                    #{t}
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts li {
    display: grid;
    grid-template-columns: 6.6em 1fr;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .posts li:last-child {
    border-bottom: 0;
  }
  time {
    padding-top: 2px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .post-title {
    margin-right: 8px;
    color: var(--ink);
    font-weight: 650;
    text-decoration: none;
  }
  .post-title:hover {
    background: var(--ink);
    color: var(--window);
  }
  .tag {
    margin-right: 4px;
  }
  .tags {
    margin-top: 6px;
  }
  .empty {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .posts li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
